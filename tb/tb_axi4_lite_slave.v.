
`timescale 1ns/1ps

module tb_axi4_lite_slave;

    reg clk = 0;
    reg rst_n = 0;

    reg [31:0] awaddr = 0;
    reg awvalid = 0;
    wire awready;

    reg [31:0] wdata = 0;
    reg [3:0] wstrb = 0;
    reg wvalid = 0;
    wire wready;

    wire [1:0] bresp;
    wire bvalid;
    reg bready = 0;

    reg [31:0] araddr = 0;
    reg arvalid = 0;
    wire arready;

    wire [31:0] rdata;
    wire [1:0] rresp;
    wire rvalid;
    reg rready = 0;

    integer timeout;
    integer aw_done;
    integer w_done;

    always #5 clk = ~clk;

    axi4_lite_slave dut (
        .clk(clk),
        .rst_n(rst_n),

        .s_axi_awaddr(awaddr),
        .s_axi_awvalid(awvalid),
        .s_axi_awready(awready),

        .s_axi_wdata(wdata),
        .s_axi_wstrb(wstrb),
        .s_axi_wvalid(wvalid),
        .s_axi_wready(wready),

        .s_axi_bresp(bresp),
        .s_axi_bvalid(bvalid),
        .s_axi_bready(bready),

        .s_axi_araddr(araddr),
        .s_axi_arvalid(arvalid),
        .s_axi_arready(arready),

        .s_axi_rdata(rdata),
        .s_axi_rresp(rresp),
        .s_axi_rvalid(rvalid),
        .s_axi_rready(rready)
    );

    task write_tx;
        input [31:0] addr;
        input [31:0] data;
        input [3:0] strb;
        begin
            @(negedge clk);
            awaddr = addr;
            wdata = data;
            wstrb = strb;
            awvalid = 1;
            wvalid = 1;
            aw_done = 0;
            w_done = 0;
            timeout = 0;

            while ((!aw_done || !w_done) && timeout < 20) begin
                @(posedge clk);
                if (awvalid && awready) aw_done = 1;
                if (wvalid && wready) w_done = 1;
                timeout = timeout + 1;
            end

            if (!aw_done || !w_done)
                $fatal(1, "Write address/data handshake timeout");

            @(negedge clk);
            awvalid = 0;
            wvalid = 0;

            timeout = 0;
            while (!bvalid && timeout < 20) begin
                @(posedge clk);
                timeout = timeout + 1;
            end

            if (!bvalid)
                $fatal(1, "Write response timeout");

            @(negedge clk);
            bready = 1;
            @(posedge clk);
            @(negedge clk);
            bready = 0;
        end
    endtask

    task read_tx;
        input [31:0] addr;
        begin
            @(negedge clk);
            araddr = addr;
            arvalid = 1;
            timeout = 0;

            while (!(arvalid && arready) && timeout < 20) begin
                @(posedge clk);
                timeout = timeout + 1;
            end

            if (!(arvalid && arready))
                $fatal(1, "Read address handshake timeout");

            @(negedge clk);
            arvalid = 0;

            timeout = 0;
            while (!rvalid && timeout < 20) begin
                @(posedge clk);
                timeout = timeout + 1;
            end

            if (!rvalid)
                $fatal(1, "Read response timeout");

            @(negedge clk);
            rready = 1;
            @(posedge clk);
            @(negedge clk);
            rready = 0;
        end
    endtask

    initial begin
        $dumpfile("axi4_lite_slave.vcd");
        $dumpvars(0, tb_axi4_lite_slave);

        repeat (3) @(negedge clk);
        rst_n = 1;

        // Test 1: Full-word write.
        write_tx(32'h00000000, 32'h12345678, 4'b1111);
        if (bresp !== 2'b00)
            $fatal(1, "Test 1 failed: expected OKAY write response");

        // Test 2: Read back the full word.
        read_tx(32'h00000000);
        if (rdata !== 32'h12345678 || rresp !== 2'b00)
            $fatal(1, "Test 2 failed: full-word readback mismatch");

        // Test 3: Change only the lowest byte.
        write_tx(32'h00000000, 32'hAABBCCDD, 4'b0001);
        read_tx(32'h00000000);
        if (rdata !== 32'h123456DD || rresp !== 2'b00)
            $fatal(1, "Test 3 failed: byte-strobe mismatch");

        // Test 4: Invalid write address.
        write_tx(32'h00000010, 32'hFFFFFFFF, 4'b1111);
        if (bresp !== 2'b10)
            $fatal(1, "Test 4 failed: expected SLVERR write response");

        // Test 5: Invalid read address.
        read_tx(32'h00000010);
        if (rresp !== 2'b10)
            $fatal(1, "Test 5 failed: expected SLVERR read response");

        $display("PASS: All five basic slave tests passed.");
        $finish;
    end

    initial begin
        #10000;
        $fatal(1, "Global simulation timeout");
    end

endmodule
